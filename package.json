{
  "name": "northwind-crm",
  "version": "2.0.0",
  "description": "Northwind relationship intelligence CRM.",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c burgundy,cyan \"npm run dev -w @northwind/api\" \"npm run dev -w @northwind/web\"",
    "start": "npm run start -w @northwind/api",
    "build": "node scripts/write-release-metadata.mjs",
    "build:hostinger": "cross-env CRM_BUILD_ON_INSTALL=1 npm run build",
    "verify:artifacts": "node scripts/verify-build-artifacts.mjs",
    "postinstall": "node scripts/conditional-postinstall.mjs",
    "test": "npm run test:unit && npm run test:legacy && npm run test:cloud",
    "test:unit": "vitest run",
    "test:legacy": "node --test tests/*.test.js",
    "test:cloud": "node --test infra/functions/**/*.test.cjs",
    "test:firestore-emulator": "node scripts/run-firestore-emulator-tests.mjs",
    "test:e2e": "playwright test",
    "start:e2e": "tsx scripts/start-e2e.ts",
    "evidence:capture": "tsx scripts/capture-evidence.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "data:migrate": "tsx scripts/migrate-data.ts",
    "data:migrate:firestore": "tsx scripts/migrate-firestore.ts --dry-run --gcloud-user",
    "data:migrate:firestore:apply": "tsx scripts/migrate-firestore.ts --apply --gcloud-user",
    "auth:hash-password": "tsx scripts/hash-password.ts",
    "doctor": "tsx scripts/doctor.ts",
    "docs:check": "node scripts/docs-check.mjs",
    "verify": "npm run docs:check && npm run format:check && npm run lint && npm run typecheck && npm test",
    "verify:release": "npm run verify && npm run audit:dependencies && npm run test:firestore-emulator && npm run build && npm run verify:artifacts && npm run test:e2e",
    "audit:dependencies": "node scripts/dependency-audit.mjs",
    "data:integrity": "tsx scripts/data-integrity.ts",
    "data:seed:staging": "tsx scripts/seed-staging.ts",
    "data:migrate:owners": "tsx scripts/migrate-owners.ts",
    "data:migrate:query-keys": "tsx scripts/migrate-query-keys.ts",
    "data:migrate:company-canonical": "tsx scripts/migrate-company-canonical-fields.ts --dry-run",
    "data:migrate:company-canonical:apply": "tsx scripts/migrate-company-canonical-fields.ts --apply",
    "data:export:firestore": "tsx scripts/export-firestore.ts",
    "data:verify-export": "tsx scripts/verify-export.ts",
    "ops:footprint": "tsx scripts/ops-footprint.ts",
    "backup:hostinger:run": "node scripts/backup-hostinger-run.mjs",
    "backup:hostinger:status": "node scripts/backup-hostinger-status.mjs",
    "backup:generate-trigger": "node scripts/backup-generate-trigger.mjs",
    "backup:generate-keys": "tsx scripts/backup-generate-keys.ts",
    "backup:decrypt": "tsx scripts/backup-decrypt.ts",
    "backup:verify": "tsx scripts/backup-verify.ts",
    "backup:restore:validate": "tsx scripts/backup-restore-validate.ts",
    "backup:restore:firestore": "tsx scripts/backup-restore-firestore.ts"
  },
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "keywords": [
    "crm",
    "relationships",
    "d365",
    "sales"
  ],
  "license": "UNLICENSED",
  "overrides": {
    "esbuild": "0.28.1",
    "find-my-way": "9.7.0",
    "gcp-metadata": "8.1.2",
    "protobufjs": "7.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "adm-zip": "0.6.0",
    "archiver": "8.0.0",
    "concurrently": "10.0.4",
    "cross-env": "10.1.0",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
