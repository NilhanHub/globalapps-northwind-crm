{
  "name": "northwind-crm",
  "version": "2.0.0",
  "description": "Northwind relationship intelligence CRM.",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c burgundy,cyan \"npm run dev -w @northwind/api\" \"npm run dev -w @northwind/web\"",
    "start": "npm run start -w @northwind/api",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test:unit && npm run test:legacy && npm run test:cloud",
    "test:unit": "vitest run",
    "test:legacy": "node --test tests/*.test.js",
    "test:cloud": "node --test infra/functions/**/*.test.cjs",
    "test:firestore-emulator": "npx --yes firebase-tools@15.6.0 emulators:exec --only firestore --project demo-northwind-crm \"npx vitest run apps/api/src/repositories/firestore-emulator.test.ts\"",
    "test:e2e": "playwright test",
    "start:e2e": "tsx scripts/start-e2e.ts",
    "evidence:capture": "tsx scripts/capture-evidence.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "data:migrate": "tsx scripts/migrate-data.ts",
    "data:migrate:firestore": "tsx scripts/migrate-firestore.ts --dry-run --gcloud-user",
    "data:migrate:firestore:apply": "tsx scripts/migrate-firestore.ts --apply --gcloud-user",
    "auth:hash-password": "tsx scripts/hash-password.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "crm",
    "relationships",
    "d365",
    "sales"
  ],
  "license": "UNLICENSED",
  "overrides": {
    "esbuild": ">=0.28.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "latest",
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "prettier": "latest",
    "tsup": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
